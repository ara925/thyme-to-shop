# Public storefront configuration. Never place Shopify Admin credentials here.
# The checkout host must stay on Shopify. It must not be the headless storefront host below.
# checkout.placeinthyme.com is connected to Shopify, TLS-certified, and active as the branded checkout host.
VITE_SHOPIFY_STORE_DOMAIN=thyme-time-store-brreo.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=replace-with-public-storefront-token
VITE_SHOPIFY_CHECKOUT_DOMAIN=checkout.placeinthyme.com
VITE_SITE_URL=https://shop.placeinthyme.com
# Customer self-service page supplied by the installed Shopify Subscriptions app.
VITE_SHOPIFY_SUBSCRIPTION_MANAGEMENT_URL=https://shopify.com/98028912938/account/pages/6971b1a1-27f6-4c27-b8b0-3009fd3b921d
# Client-approved local fulfillment. Keep Shopify's location, local-delivery,
# pickup, rate, and minimum-order settings synchronized with these values.
# Set true only after those matching Shopify Admin settings pass acceptance.
VITE_SHOPIFY_LOCAL_FULFILLMENT_READY=false
VITE_ENABLE_PICKUP=true
VITE_DELIVERY_WINDOWS_JSON=[{"value":"monday","label":"Monday"},{"value":"tuesday","label":"Tuesday"}]
VITE_PICKUP_WINDOWS_JSON=[{"value":"monday-after-9am","label":"Monday after 9:00 AM"}]
