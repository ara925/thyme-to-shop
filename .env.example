# Public storefront configuration. Never place Shopify Admin credentials here.
# The checkout host must stay on Shopify. It must not be the headless storefront host below.
VITE_SHOPIFY_STORE_DOMAIN=thyme-time-store-brreo.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=replace-with-public-storefront-token
VITE_SHOPIFY_CHECKOUT_DOMAIN=thyme-time-store-brreo.myshopify.com
VITE_SITE_URL=https://shop.placeinthyme.com
# Customer self-service page supplied by the installed Shopify Subscriptions app.
VITE_SHOPIFY_SUBSCRIPTION_MANAGEMENT_URL=https://shopify.com/98028912938/account/pages/6971b1a1-27f6-4c27-b8b0-3009fd3b921d
# Only set true after Shopify pickup and an approved pickup address/instructions are configured.
VITE_ENABLE_PICKUP=false
# Required for checkout: JSON arrays of client-approved combined day/time windows.
# Shape only: [{"value":"approved-window-id","label":"Monday, <approved time>"}]
# No delivery or pickup window is assumed when these values are blank or invalid.
VITE_DELIVERY_WINDOWS_JSON=
VITE_PICKUP_WINDOWS_JSON=
