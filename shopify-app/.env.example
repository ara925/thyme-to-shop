# Private app configuration. Never use a VITE_ prefix or commit real values.
PIT_APP_URL=https://replace-with-independent-app-host
SHOPIFY_API_SECRET=
# Existing headless channel's PUBLIC Storefront token, not an Admin credential.
# This is used only for separate subscription carts; no new access scope is requested.
SHOPIFY_STOREFRONT_TOKEN=
# 32 random bytes, base64 encoded; store in the host's private environment settings.
PIT_ENCRYPTION_KEY=
# Absolute path on a verified persistent, backed-up volume. Not the marketing-site filesystem.
PIT_DATABASE_PATH=/replace-with-persistent-app-storage/rotation.sqlite
PORT=3000
# Set true BEFORE restoring a backup. It pauses workers, setup and customer changes
# until Shopify reconciliation is complete. It does not enable any acceptance gate.
PIT_RECOVERY_HOLD=false
# All acceptance gates default OFF. A deployment or OAuth connection cannot enable billing.
PIT_BILLING_VERIFIED=false
PIT_CHECKOUT_VERIFIED=false
PIT_FULFILLMENT_VERIFIED=false
PIT_STOREFRONT_VERIFIED=false
PIT_LAUNCH_VERIFIED=false
PIT_PERSISTENT_STORAGE_VERIFIED=false
# Separate acceptance of the custom-juice native plans, four-week commitment,
# prepaid delivery scheduling, cancellation boundary and real billing tests.
PIT_JUICE_VERIFIED=false
